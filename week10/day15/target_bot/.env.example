# AI Target Bot — пример переменных окружения
# Скопируй в .env и заполни значениями

# Bearer токены для аутентификации (сгенерируй через uuid.uuid4())
DANIL_TOKEN=your-danil-uuid-here
PARTNER_TOKEN=your-partner-uuid-here

# Внутренний ключ персоны AITechCo (сгенерируй через uuid.uuid4())
INTERNAL_API_KEY=sk-aitechco-your-uuid-here

# Путь к credentials Claude для извлечения OAuth токена
CLAUDE_CREDENTIALS_PATH=/home/claudeuser/.claude/.credentials.json

# SQLite база данных для хранения сессий
DB_PATH=/home/claudeuser/sessions/common/workspace/ai_target_bot/sessions.db

# Порт сервиса
PORT=8091
